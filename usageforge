#!/usr/bin/env bash
# UsageForge — your AI usage window, on your schedule. (Claude Code + Codex, 5-hour window)
#
#   usageforge ping [claude|codex]     send one tiny message now
#   usageforge schedule 06:00 11:00    ping at these times every day   (mode 1)
#   usageforge watch                   ping as soon as each window resets (mode 2)
#   usageforge status                  show reset times, the installed job, recent log
#   usageforge stop                    remove the schedule/watch job
#
# Env (captured at install): UF_TOOLS="claude codex" (default: whichever is installed),
#                            UF_CLAUDE_MODEL=haiku, UF_STATE=~/.local/state/usageforge
set -uo pipefail
VERSION=1.0.0

STATE="${UF_STATE:-$HOME/.local/state/usageforge}"
MODEL="${UF_CLAUDE_MODEL:-haiku}"
TOOLS="${UF_TOOLS:-$(command -v claude >/dev/null && echo claude) $(command -v codex >/dev/null && echo codex)}"
SESSIONS="${CODEX_HOME:-$HOME/.codex}/sessions"
LABEL=dev.usageforge
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
MSG=hi

command -v jq >/dev/null || { echo "usageforge needs jq (brew install jq / apt install jq)" >&2; exit 1; }
[[ $MODEL =~ ^[A-Za-z0-9._-]+$ ]] || { echo "bad UF_CLAUDE_MODEL: $MODEL" >&2; exit 1; }
mkdir -p "$STATE"

log() { echo "$(date '+%F %T') $*" >>"$STATE/log"; echo "$*"; }
now() { date +%s; }
int() { [[ ${1:-} =~ ^[0-9]+$ ]] && echo "$1" || echo 0; }
fmt() { date -r "$1" '+%a %H:%M' 2>/dev/null || date -d "@$1" '+%a %H:%M'; }
xml() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<<"$1"; }
# Jobs wait a random 0-2 min so pings don't land on the same second every day.
jitter() { local j=${UF_JITTER:-120}; [ "$j" -gt 0 ] && sleep $(( RANDOM % j )); return 0; }
# macOS has no `timeout`; a hung ping would block every later launchd run.
limit() { perl -e 'alarm shift; exec @ARGV' 120 "$@"; }

# Epoch second when the tool may next be pinged (0 = now). Always prints one integer.
reset_at() {
  case $1 in
    claude) int "$(cat "$STATE/claude.reset" 2>/dev/null)" ;;
    # Codex logs its own limits, so manual usage counts too. Weekly cap hit -> wait for the weekly reset.
    codex) int "$(ls -t "$SESSIONS"/*/*/*/rollout-*.jsonl 2>/dev/null | head -3 |
             xargs grep -h '"rate_limits"' 2>/dev/null |
             jq -s 'map(.payload.rate_limits | if (.secondary.used_percent // 0) >= 100
                        then .secondary.resets_at else .primary.resets_at end // 0) | max // 0' 2>/dev/null)" ;;
  esac
}

# Returns 0 on success, 2 if the account is rate-limited (reset time saved), 1 on other failure.
ping_claude() {
  local out ok=0 r
  # Empty cwd + no user settings = no hooks/plugins/MCP/CLAUDE.md, so the ping costs almost nothing.
  out=$(cd "$STATE" && limit claude -p "$MSG" --model "$MODEL" --tools "" \
          --setting-sources project --strict-mcp-config --no-session-persistence \
          --output-format stream-json --verbose 2>>"$STATE/log") || ok=1
  out=$(jq -Rc 'fromjson? | select(.type=="rate_limit_event") | .rate_limit_info' <<<"$out" | tail -1)
  if [ "$(jq -r '.status // empty' <<<"$out")" = rejected ]; then
    int "$(jq -r '.resetsAt // empty' <<<"$out")" >"$STATE/claude.reset"; return 2
  fi
  [ $ok = 0 ] || return 1
  r=$(int "$(jq -r '.unifiedWindows.five_hour.resetsAt // (select(.rateLimitType=="five_hour") | .resetsAt) // empty' <<<"$out")")
  # ponytail: no five_hour info -> assume this ping opened a fresh 5h window.
  [ "$r" -gt 0 ] || r=$(( $(now) + 18000 ))
  echo "$r" >"$STATE/claude.reset"
}

ping_codex() {
  # ponytail: still loads ~/.codex/config.toml (MCP servers etc.); add --ignore-user-config once widely shipped.
  (cd "$STATE" && limit codex exec --skip-git-repo-check --sandbox read-only \
     -c model_reasoning_effort=low "$MSG" </dev/null >/dev/null 2>>"$STATE/log")
}

ping() {
  local t try rc
  for t in ${*:-$TOOLS}; do
    case $t in claude|codex) ;; *) log "unknown tool: $t"; continue ;; esac
    command -v "$t" >/dev/null || { log "skip $t: not installed"; continue; }
    # Retry: right after wake-up the network is often not back yet.
    for try in 1 2 3; do
      "ping_$t"; rc=$?
      [ $rc = 1 ] && [ $try -lt 3 ] && { sleep "${UF_RETRY_DELAY:-60}"; continue; }
      break
    done
    case $rc in
      0) log "pinged $t, window resets $(fmt "$(reset_at "$t")")" ;;
      2) log "$t is rate-limited until $(fmt "$(reset_at "$t")")" ;;
      *) log "ping $t failed (offline or logged out?), retrying in 15 min"; echo $(( $(now) + 900 )) >"$STATE/$t.backoff" ;;
    esac
  done
}

# Ping every tool whose window has ended. Cheap no-op otherwise; runs every 5 min in watch mode.
tick() {
  local t
  for t in $TOOLS; do
    [ "$(now)" -lt "$(int "$(cat "$STATE/$t.backoff" 2>/dev/null)")" ] && continue
    if [ "$(now)" -ge "$(reset_at "$t")" ]; then jitter; ping "$t"; fi
  done
}

# install <cmd> <launchd schedule xml> <cron schedule lines...>
install() {
  local cmd=$1 sched=$2 bin="$STATE/usageforge" env line; shift 2
  stop >/dev/null
  # Run a copy: launchd can't read ~/Desktop or ~/Documents (macOS privacy), and the repo may move.
  cp "$SELF" "$bin" && chmod +x "$bin" || { echo "install failed: copy to $bin" >&2; exit 1; }
  if [ "$(uname)" = Darwin ]; then
    # launchd (not cron): runs in your login session so `claude` can read its Keychain token,
    # and runs missed jobs when the Mac wakes up.
    mkdir -p "$(dirname "$PLIST")"
    cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$(xml "$bin")</string><string>$cmd</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>$(xml "$PATH")</string>
    <key>UF_TOOLS</key><string>$(xml "$TOOLS")</string>
    <key>UF_CLAUDE_MODEL</key><string>$MODEL</string>
    <key>UF_STATE</key><string>$(xml "$STATE")</string>
  </dict>
  $sched
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>$(xml "$STATE/log")</string>
</dict></plist>
EOF
    plutil -lint -s "$PLIST" || { echo "install failed: bad plist $PLIST" >&2; exit 1; }
    # bootstrap right after bootout sometimes fails with "I/O error"; one retry fixes it.
    launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || { sleep 2; launchctl bootstrap "gui/$(id -u)" "$PLIST"; } ||
      { echo "install failed: launchctl bootstrap" >&2; exit 1; }
  else
    env="PATH=$(printf %q "$PATH") UF_TOOLS=$(printf %q "$TOOLS") UF_CLAUDE_MODEL=$MODEL UF_STATE=$(printf %q "$STATE")"
    { crontab -l 2>/dev/null; for line in "$@"; do echo "$line ${env//%/\\%} $(printf %q "$bin") $cmd # $LABEL"; done; } | crontab - ||
      { echo "install failed: crontab" >&2; exit 1; }
  fi
  echo "installed: $cmd for [$TOOLS]. Log: $STATE/log"
}

stop() {
  if [ "$(uname)" = Darwin ]; then
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null; rm -f "$PLIST"
  else
    crontab -l 2>/dev/null | grep -v "# $LABEL\$" | crontab -
  fi
  echo "stopped (state kept in $STATE)"
}

schedule() {
  [ $# -gt 0 ] || { echo "usage: usageforge schedule HH:MM [HH:MM...]"; exit 1; }
  local sched="<key>StartCalendarInterval</key><array>" cron=() t h m
  for t in "$@"; do
    [[ $t =~ ^([01]?[0-9]|2[0-3]):([0-5][0-9])$ ]] || { echo "bad time: $t (want HH:MM)"; exit 1; }
    h=$((10#${BASH_REMATCH[1]})) m=$((10#${BASH_REMATCH[2]}))
    sched+="<dict><key>Hour</key><integer>$h</integer><key>Minute</key><integer>$m</integer></dict>"
    cron+=("$m $h * * *")
  done
  install scheduled "$sched</array>" "${cron[@]}"
}

status() {
  local t r job
  for t in $TOOLS; do
    r=$(reset_at "$t"); [ "$r" -gt "$(now)" ] && echo "$t: window resets $(fmt "$r")" || echo "$t: no window running"
  done
  if [ "$(uname)" = Darwin ]; then
    launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1 && job=$(grep -oE '<string>(scheduled|tick)</string>' "$PLIST" | sed 's/<[^>]*>//g')
  else
    job=$(crontab -l 2>/dev/null | grep "# $LABEL\$" | grep -oE '(scheduled|tick) #' | head -1 | cut -d' ' -f1)
  fi
  case ${job:-} in scheduled) echo "job: schedule" ;; tick) echo "job: watch" ;; *) echo "job: none" ;; esac
  [ -f "$STATE/log" ] && { echo "recent log:"; tail -n 5 "$STATE/log" | sed 's/^/  /'; }
  return 0
}

case "${1:-}" in
  ping) shift; ping "$@" ;;
  scheduled) jitter; ping ;;
  tick) tick ;;
  schedule) shift; schedule "$@" ;;
  watch) install tick "<key>StartInterval</key><integer>300</integer><key>RunAtLoad</key><true/>" "*/5 * * * *" ;;
  status) status ;;
  stop) stop ;;
  -v|--version|version) echo "usageforge $VERSION" ;;
  *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
