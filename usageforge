#!/usr/bin/env bash
# UsageForge — your AI usage window, on your schedule. (Claude Code + Codex, 5-hour window)
#
#   usageforge ui                       open the local control panel in your browser
#   usageforge schedule 06:00 11:00     ping at these times every day        (mode: schedule)
#   usageforge watch                    ping as soon as each window resets   (mode: watch)
#   usageforge ping [claude|codex]      send one message now
#   usageforge status [--json]          modes, reset times, recent log
#   usageforge doctor                   check the setup and say what to fix
#   usageforge start | stop             turn the background check on / off
#   usageforge sleep on | off           sleep the Mac once agents finish, then switch off (macOS)
#   usageforge wake on | off | allow    wake a sleeping Mac for each set time (macOS; on by default)
#
# Settings live in ~/.local/state/usageforge/config.json, per tool: mode, times, days, prompt, model.
# `schedule` and `watch` apply to UF_TOOLS (default: whichever of claude/codex is installed).
set -uo pipefail
umask 077
VERSION=3.8.5

# Codex ships inside the ChatGPT desktop app; use that copy when no codex CLI is installed.
APP_CODEX=/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin
command -v codex >/dev/null || { [ -x "$APP_CODEX/codex" ] && PATH="$PATH:$APP_CODEX"; }

STATE="${UF_STATE:-$HOME/.local/state/usageforge}"
case $STATE in /*) ;; *) STATE="$PWD/$STATE" ;; esac   # launchd runs jobs from /
CONFIG="$STATE/config.json"
TOOLS="${UF_TOOLS:-$(command -v claude >/dev/null && echo claude) $(command -v codex >/dev/null && echo codex)}"
SESSIONS="${CODEX_HOME:-$HOME/.codex}/sessions"
CLAUDE_JSON="${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json"
LABEL=dev.usageforge
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
# Resolve symlinks (e.g. ~/.local/bin/usageforge -> repo) so `ui` can find ui/server.py.
SELF=$(readlink -f "$0" 2>/dev/null) || SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

command -v jq >/dev/null || { echo "usageforge needs jq (brew install jq / apt install jq)" >&2; exit 1; }
mkdir -p "$STATE"

log() { echo "$(date '+%F %T') $*" >>"$STATE/log"; echo "$*"; }
now() { date +%s; }
int() { [[ ${1:-} =~ ^[0-9]+$ ]] && echo "$1" || echo 0; }
fmt() { date -d "@$1" '+%a %H:%M' 2>/dev/null || date -r "$1" '+%a %H:%M'; }
# Epoch second of HH:MM today.
at() { date -d "$(date +%F) $1" +%s 2>/dev/null || date -j -f '%Y-%m-%d %H:%M:%S' "$(date +%F) $1:00" +%s; }
# A plain greeting for the time of day is the default ping.
greet() { local h; h=$((10#$(date +%H))); [ "$h" -lt 12 ] && echo "Good morning" || { [ "$h" -lt 18 ] && echo "Good afternoon" || echo "Good evening"; }; }
xml() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<<"$1"; }
# Jobs wait a random 0-2 min so pings don't land on the same second every day.
jitter() { local j=${UF_JITTER:-120}; [ "$j" -gt 0 ] && sleep $(( RANDOM % j )); return 0; }
# macOS has no `timeout`; a hung ping would block every later launchd run.
limit() { perl -e 'alarm shift; exec @ARGV' 120 "$@"; }

# ---------- Settings ----------

# cfg <tool> <key>: one setting; arrays come back space-separated.
cfg() { jq -r --arg t "$1" --arg k "$2" '.[$t][$k] // empty | if type == "array" then map(tostring) | join(" ") else tostring end' "$CONFIG" 2>/dev/null; }

# set_mode <mode> [HH:MM...]: set the mode (and times) of every tool in $TOOLS.
set_mode() {
  local patch t
  patch=$(jq -n --arg m "$1" '{mode: $m} + (if ($ARGS.positional | length) > 0 then {times: $ARGS.positional} else {} end)' --args "${@:2}")
  for t in $TOOLS; do
    { [ -s "$CONFIG" ] && cat "$CONFIG" || echo '{}'; } |
      jq --arg t "$t" --argjson p "$patch" '.[$t] = ((.[$t] // {}) + $p)' >"$CONFIG.tmp" && mv -f "$CONFIG.tmp" "$CONFIG"
  done
}

model_for() {
  local m; m=$(cfg "$1" model)
  [ -z "$m" ] && [ "$1" = claude ] && m=haiku
  [[ -z $m || $m =~ ^[A-Za-z0-9._-]+$ ]] && echo "$m"
}
# The saved prompt, or a greeting. Never starts with "-".
prompt_for() { local p; p=$(cfg "$1" prompt); p=${p:-$(greet)}; [[ $p == -* ]] && p=" $p"; printf '%s' "$p"; }

# ---------- Notifications ----------

# notify <kind> <title> <message>. One kind, problems: on unless switched off in the panel.
notify() {
  local on
  on=$(jq -r --arg k "$1" '.notify[$k] | if . == null then true else . end' "$CONFIG" 2>/dev/null) || on=true
  [ "${on:-true}" = true ] || [ -n "${UF_FORCE:-}" ] || return 0
  if [ "$(uname)" = Darwin ]; then
    # Text goes in as arguments, never into the AppleScript source.
    osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' "$2" "$3" >/dev/null 2>&1
  elif command -v notify-send >/dev/null; then
    notify-send "$2" "$3" 2>/dev/null
  fi
  return 0
}
# once <key> <minutes>: succeeds at most once per period, so a problem doesn't notify every 5 minutes.
once() { [ -n "$(find "$STATE/$1.note" -mmin -"$2" 2>/dev/null)" ] && return 1; touch "$STATE/$1.note"; }
mode_name() { case $1 in schedule) echo "At set times" ;; watch) echo "Back to back" ;; *) echo "Off" ;; esac; }
name_of() { [ "$1" = claude ] && echo "Claude Code" || echo "Codex"; }

# ---------- Reading the windows ----------

# How old (minutes) the live numbers may be before asking the tools again. Each ask is a small,
# read-only request from the tool's own CLI; keep them rare: 5 min for the panel and menu bar,
# 15 min for the background check (a ping refreshes them anyway).
LIVE_AGE=${UF_LIVE_AGE:-5}

# Codex's limits, live: the same call the Codex app makes (`codex app-server`, account/rateLimits/read).
# It reads the account's numbers and sends no message, so it costs no quota. Kept for LIVE_AGE.
# Plain bash 3.2 (no coproc): requests go in through a FIFO, the reply is read from a file.
codex_live() {
  local dir pid i
  [ -n "$(find "$STATE/codex.live" -mmin -"$LIVE_AGE" 2>/dev/null)" ] && { cat "$STATE/codex.live"; return 0; }
  command -v codex >/dev/null || return 1
  dir=$(mktemp -d "$STATE/live.XXXXXX") && mkfifo "$dir/in" || return 1
  perl -e 'alarm 20; exec @ARGV' codex app-server <"$dir/in" >"$dir/out" 2>/dev/null & pid=$!
  exec 8>"$dir/in"
  printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"clientInfo":{"name":"usageforge","version":"'"$VERSION"'"}}}' \
    '{"jsonrpc":"2.0","method":"initialized"}' '{"jsonrpc":"2.0","id":2,"method":"account/rateLimits/read"}' >&8
  for i in $(seq 100); do grep -q '"id":2' "$dir/out" 2>/dev/null && break; kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
  exec 8>&-; kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
  grep -h '"id":2' "$dir/out" 2>/dev/null | jq -c 'select(.result.rateLimits.primary != null) | .result.rateLimits |
    {primary: {used_percent: .primary.usedPercent, resets_at: .primary.resetsAt},
     secondary: (.secondary | if . then {used_percent: .usedPercent, resets_at: .resetsAt} else null end)}' >"$dir/r" 2>/dev/null
  [ -s "$dir/r" ] && mv -f "$dir/r" "$STATE/codex.live"
  rm -rf "$dir"
  [ -s "$STATE/codex.live" ] && [ -n "$(find "$STATE/codex.live" -mmin -"$LIVE_AGE")" ] && cat "$STATE/codex.live"
}

# Codex's limits: live when the CLI can say, else the newest rate_limits in its session logs.
# Newest by time, not the latest reset: after switching accounts, the old account's window can end
# later than the current one's. Hitting the limit logs an error, not new numbers: then the window
# counts as full until it resets.
codex_limits() {
  codex_live && return 0
  find "$SESSIONS" -name 'rollout-*.jsonl' -mtime -8 -exec ls -t {} + 2>/dev/null | head -5 |
    while IFS= read -r f; do grep -h -e '"rate_limits"' -e usage_limit_exceeded "$f"; done |
    jq -sc 'def secs: sub("\\.[0-9]+"; "") | fromdateiso8601;
      (map(select(.payload.rate_limits.primary != null)) | max_by(.timestamp // "")) as $e |
      ($e.payload.rate_limits // {}) as $r |
      # ponytail: assumes the 5-hour window is the one that ran out; the weekly cap shows in its own numbers.
      if any(.[]; (.payload.error? | objects | .codex_error_info) == "usage_limit_exceeded"
             and .timestamp > ($e.timestamp // "") and (.timestamp | secs) < ($r.primary.resets_at // 0))
      then $r | .primary.used_percent = 100 else $r end' 2>/dev/null
}

# Claude's usage, as Claude Code's own /usage gets it from Anthropic: no message is sent, so it costs no
# quota. Claude Code keeps what it last fetched in ~/.claude.json, and the endpoint answers 429 when asked
# often (seen 2026-10-15, after the menu bar asked every 5 min): so read that copy, and ask again only when
# it is older than LIVE_AGE minutes or than our last ping, at most every 15 min (1 for the Refresh button).
claude_cache() {
  jq -c '.cachedUsageUtilization // empty | select(.utilization.limits) |
    {at: ((.fetchedAtMs // 0) / 1000 | floor), limits: .utilization.limits}' "$CLAUDE_JSON" 2>/dev/null
}
claude_usage() {
  local out="" rep at gap=15 safe=()
  [ "$LIVE_AGE" = 0 ] && gap=1
  at=$(int "$(claude_cache | jq '.at')")
  if { [ "$at" -lt $(( $(now) - LIVE_AGE * 60 )) ] || [ "$at" -lt "$(int "$(cat "$STATE/claude.last" 2>/dev/null)")" ]; } &&
     [ $(( $(now) - $(int "$(stat -f %m "$STATE/claude.asked" 2>/dev/null || stat -c %Y "$STATE/claude.asked" 2>/dev/null)") )) -ge $(( gap * 60 )) ]; then
    touch "$STATE/claude.asked"
    claude --help 2>/dev/null | grep -q -- --safe-mode && safe=(--safe-mode)
    out=$(cd "$STATE" && limit claude -p "/usage" --tools "" ${safe[@]+"${safe[@]}"} --setting-sources project \
            --strict-mcp-config --no-session-persistence --output-format stream-json --verbose 2>/dev/null)
  fi
  # Claude Code before 2.1.299 printed the numbers with the reply; newer ones only save them.
  rep=$(jq -c --argjson now "$(now)" 'select(.usage_report) | {at: $now, limits: .usage_report.rate_limits.limits}' <<<"$out" 2>/dev/null | tail -1)
  [ -n "$rep" ] || rep=$(claude_cache)
  [ -n "$rep" ] || return 0
  # is_active can be false while the window is open (seen 2026-10-08), so any usage counts as open too.
  rep=$(jq -c '
    def secs: if . == null then null elif type == "string"
      then (sub("\\.[0-9]+"; "") | sub("[+]00:00$"; "Z") | try fromdateiso8601 catch null) else . end;
    .at as $at | .limits | (map(select(.kind == "session")) | first) as $s | (map(select(.kind == "weekly_all")) | first) as $w |
    {source: "usage", at: $at, unifiedWindows: {
      five_hour: {utilization: (($s.percent // 0) / 100), resetsAt: (if $s.is_active or ($s.percent // 0) > 0 then ($s.resets_at | secs) else null end)},
      seven_day: {utilization: (($w.percent // 0) / 100), resetsAt: ($w.resets_at | secs)}}}' <<<"$rep") || return 0
  echo "$rep" >"$STATE/claude.limits.$$" && mv -f "$STATE/claude.limits.$$" "$STATE/claude.limits"
  # Weekly cap hit -> wait for the weekly reset; otherwise the open window's reset. A ping barely
  # moves the needle, so 0% may still be an open window: then keep the reset our last ping saved.
  local saved; saved=$(int "$(cat "$STATE/claude.reset" 2>/dev/null)")
  jq -r --argjson now "$(now)" --argjson saved "$saved" '.unifiedWindows as $u |
    if $u.seven_day.utilization >= 1 then $u.seven_day.resetsAt
    elif ($u.five_hour.resetsAt // 0) > $now then $u.five_hour.resetsAt
    elif $saved > $now then $saved else 0 end // 0' <<<"$rep" >"$STATE/claude.reset.$$" &&
    mv -f "$STATE/claude.reset.$$" "$STATE/claude.reset"
}

# Epoch second when the tool may next be pinged (0 = now). Always prints one integer.
reset_at() {
  case $1 in
    claude) int "$(cat "$STATE/claude.reset" 2>/dev/null)" ;;
    # Codex logs its own limits, so manual usage counts too. Weekly cap hit -> wait for the weekly reset.
    # An open window in the log wins (it follows account switches); otherwise our own last ping,
    # so unreadable logs can never mean "ping every tick". At 0% Codex still gives a reset time
    # (seen 2026-10-11: no window open, yet the 06:00 slot never fired), so 0% counts as no window.
    codex) local log saved
           log=$(int "$(codex_limits | jq 'if (.secondary.used_percent // 0) >= 100 then .secondary.resets_at
             elif (.primary.used_percent // 0) > 0 then .primary.resets_at else 0 end // 0' 2>/dev/null)")
           saved=$(int "$(cat "$STATE/codex.reset" 2>/dev/null)")
           [ "$log" -gt "$(now)" ] && echo "$log" || echo "$saved" ;;
    *) echo 0 ;;
  esac
}

# ---------- Pinging ----------

# Returns 0 on success, 2 if the account is rate-limited (reset time saved), 1 on other failure.
ping_claude() {
  local out ok=0 r model safe=()
  model=$(model_for claude) || return 1
  # Empty cwd + no user settings = no hooks/plugins/MCP/CLAUDE.md, so the ping costs almost nothing.
  claude --help 2>/dev/null | grep -q -- --safe-mode && safe=(--safe-mode)
  out=$(cd "$STATE" && limit claude -p "$(prompt_for claude)" --model "$model" --tools "" ${safe[@]+"${safe[@]}"} \
          --setting-sources project --strict-mcp-config --no-session-persistence \
          --output-format stream-json --verbose 2>>"$STATE/log") || ok=1
  out=$(jq -Rc 'fromjson? | select(.type == "rate_limit_event") | .rate_limit_info' <<<"$out" | tail -1)
  # The meters come from /usage, in their own shape: let the next read ask for fresh ones.
  rm -f "$STATE/claude.asked"
  if [ "$(jq -r '.status // empty' <<<"$out")" = rejected ]; then
    r=$(int "$(jq -r '.resetsAt // empty' <<<"$out")")
    echo $(( r > 0 ? r : $(now) + 900 )) >"$STATE/claude.reset"; return 2
  fi
  [ $ok = 0 ] || return 1
  r=$(int "$(jq -r '.unifiedWindows.five_hour.resetsAt // (select(.rateLimitType == "five_hour") | .resetsAt) // empty' <<<"$out")")
  # ponytail: no five_hour info -> assume this ping opened a fresh 5h window.
  [ "$r" -gt 0 ] || r=$(( $(now) + 18000 ))
  echo "$r" >"$STATE/claude.reset"
}

ping_codex() {
  local model help lean=()
  model=$(model_for codex) || return 1
  # --ignore-user-config skips ~/.codex/config.toml (MCP servers etc.) on CLIs that support it.
  # --ephemeral: no session file, which would look like an agent at work and keep the Mac up 10 min.
  help=$(codex exec --help 2>/dev/null)
  grep -q -- --ignore-user-config <<<"$help" && lean=(--ignore-user-config)
  grep -q -- --ephemeral <<<"$help" && lean+=(--ephemeral)
  [ -n "$model" ] && lean+=(-m "$model")
  # Codex echoes the whole prompt (incl. your AGENTS.md) on stderr: keep it out of the log unless it failed.
  (cd "$STATE" && limit codex exec --skip-git-repo-check --sandbox read-only ${lean[@]+"${lean[@]}"} \
     -c model_reasoning_effort=low "$(prompt_for codex)" </dev/null >/dev/null 2>"$STATE/codex.err") || {
    # Out of usage: not worth retrying. reset_at reads the window's end from the log.
    grep -q "hit your usage limit" "$STATE/codex.err" && return 2
    awk '/ERROR/ && !seen[$0]++' "$STATE/codex.err" | tail -n 3 >>"$STATE/log"; return 1; }
  # Trust the reset time Codex now reports; if a window was already open it ends sooner than 5h from now.
  rm -f "$STATE/codex.live"
  local r; r=$(int "$(codex_limits | jq '.primary.resets_at // 0' 2>/dev/null)")
  echo $(( r > $(now) ? r : $(now) + 18000 )) >"$STATE/codex.reset"
}

# Exits non-zero if any tool's message didn't go through.
ping() {
  local t try rc failed=0
  for t in ${*:-$TOOLS}; do
    case $t in claude|codex) ;; *) echo "unknown tool: $t (use claude or codex)" >&2; failed=1; continue ;; esac
    command -v "$t" >/dev/null || { log "skip $t: not installed"; continue; }
    # Retry: right after wake-up the network is often not back yet.
    for try in 1 2 3; do
      "ping_$t"; rc=$?
      [ $rc = 1 ] && [ $try -lt 3 ] && { sleep "${UF_RETRY_DELAY:-60}"; continue; }
      break
    done
    case $rc in
      0) now >"$STATE/$t.last"; log "pinged $t (${UF_WHY:-manual}), window resets $(fmt "$(reset_at "$t")")" ;;
      2) log "$t is rate-limited until $(fmt "$(reset_at "$t")")"
         once "limit-$t" 300 && notify problems "$(name_of "$t"): usage limit reached" "UsageForge waits until $(fmt "$(reset_at "$t")")." ;;
      *) [ "${UF_WHY:-manual}" = manual ] && { log "ping $t failed (offline or logged out?)"; failed=1; continue; }
         log "ping $t failed (offline or logged out?); retrying in 15 min"; echo $(( $(now) + 900 )) >"$STATE/$t.backoff"
         once "fail-$t" 360 && notify problems "$(name_of "$t"): couldn't start a window" "Offline or signed out? Run 'usageforge doctor'. Retrying in 15 min." ;;
    esac
    [ "$rc" = 0 ] || failed=1
  done
  return $failed
}

# ---------- The 5-minute check ----------

# added <tool> <time>: when this set time was saved. A time first seen here was saved at the last
# edit at the latest. Times no longer set are forgotten, so one removed and added back counts as new.
# ponytail: removed and re-added within one 5-minute check still counts as old.
added() {
  local f="$STATE/$1.added" a
  a=$(awk -v k="$2" '$1 == k {print $2; exit}' "$f" 2>/dev/null)
  [ -n "$a" ] || { a=$(int "$(date -r "$CONFIG" +%s 2>/dev/null)"); echo "$2 $a" >>"$f"; }
  echo "$a"
}

# due <tool>: should this tool be pinged right now, according to its mode?
due() {
  local t=$1 days time times ts last slot="" r ws we
  case $(cfg "$t" mode) in
    watch) [ "$(now)" -ge "$(reset_at "$t")" ] ;;
    schedule)
      days=$(cfg "$t" days) times=$(cfg "$t" times)
      last=$(int "$(cat "$STATE/$t.last" 2>/dev/null)")
      [ -f "$STATE/$t.added" ] && awk -v keep=" $times " 'index(keep, " " $1 " ")' "$STATE/$t.added" >"$STATE/$t.added.tmp" &&
        mv -f "$STATE/$t.added.tmp" "$STATE/$t.added"
      for time in $times; do added "$t" "$time" >/dev/null; done   # note new times now, before a later save
      for time in $times; do
        [[ $time =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]] || continue
        # Today's slot, and yesterday's (a 23:30 slot still catches up at 00:40).
        for back in 0 1; do
          ts=$(( $(int "$(at "$time")") - back * 86400 ))
          [ -z "$days" ] || [[ " $days " == *" $(( ($(date +%w) + 7 - back) % 7 )) "* ]] || continue
          # Fire once per slot; a Mac that wakes up to 3 h late still catches up. A time saved after
          # it passed waits for tomorrow, as the panel shows.
          [ "$(now)" -ge "$ts" ] && [ "$(now)" -lt $(( ts + 10800 )) ] && [ "$last" -lt "$ts" ] && [ "$(added "$t" "$time")" -lt "$ts" ] && slot=$ts
        done
      done
      # A set time held back by an open window goes out once that window ends, even past its 3 h, but only
      # inside its own 5 hours: a 21:00 held until 03:12 then pushed 06:00 to 08:18, and the rest of the
      # day along with it (2026-10-14).
      if [ -z "$slot" ]; then
        { read -r ws we <"$STATE/$t.waits"; } 2>/dev/null; ws=$(int "${ws:-}") we=$(int "${we:-}")
        [ "$last" -lt "$ws" ] && [ "$we" -lt $(( ws + 18000 )) ] && [ "$(now)" -ge "$we" ] && [ "$(now)" -lt $(( we + 10800 )) ] && slot=$ws
      fi
      [ -n "$slot" ] || return 1
      # A message inside an open window doesn't start a new one: wait for it to end.
      [ "$t" = claude ] && claude_usage
      r=$(reset_at "$t")
      [ "$(now)" -ge "$r" ] && return 0
      if [ "$(cut -d' ' -f1 "$STATE/$t.waits" 2>/dev/null)" != "$slot" ]; then
        if [ "$r" -lt $(( slot + 18000 )) ]; then log "$t: $(fmt "$slot") goes out when the open window ends ($(fmt "$r"))" >/dev/null
        else log "$t: $(fmt "$slot") skipped: nothing can start until $(fmt "$r"), after its 5 hours" >/dev/null; fi
      fi
      echo "$slot $r" >"$STATE/$t.waits"
      return 1 ;;
    *) return 1 ;;
  esac
}

tick() {
  local t
  LIVE_AGE=${UF_LIVE_AGE:-15}
  # After a wake we scheduled, hold the Mac up until this run ends: with the lid closed macOS goes back
  # to sleep within seconds, which froze the 11:00 message until the lid opened (2026-10-11). -s works
  # on AC only. Only then, so a run that starts as the Mac goes to sleep doesn't hold it up.
  [ "$(uname)" = Darwin ] && our_wake >/dev/null && { caffeinate -i -s -w $$ >/dev/null 2>&1 & HOLD=$!; disown; }   # disown: no "Terminated" line in the log
  [ "$(wc -l 2>/dev/null <"$STATE/log" || echo 0)" -gt 2000 ] && { tail -n 1000 "$STATE/log" >"$STATE/log.tmp" && mv -f "$STATE/log.tmp" "$STATE/log"; }
  for t in claude codex; do
    if ! command -v "$t" >/dev/null; then
      # Say so (hourly at most) instead of silently doing nothing.
      [ -n "$(cfg "$t" mode | grep -v '^off$')" ] && [ -z "$(find "$STATE/$t.missing" -mmin -60 2>/dev/null)" ] &&
        { log "skip $t: not found on the background job's PATH (run 'usageforge start' from a shell where it works)"; touch "$STATE/$t.missing"; }
      continue
    fi
    [ "$(now)" -lt "$(int "$(cat "$STATE/$t.backoff" 2>/dev/null)")" ] && continue
    # Live usage only when it decides something: every check in Back to back, else when a time is due (in due).
    [ "$t" = claude ] && [ "$(cfg claude mode)" = watch ] && claude_usage
    due "$t" && { jitter; UF_WHY=$(cfg "$t" mode) ping "$t"; }
  done
  sleep_check
  back_to_sleep
  wake_sync
  return 0
}

# ---------- Sleep and wake (macOS) ----------
# Sleep (off by default): switch it on as you leave; the Mac stays awake while Claude Code or Codex
# is working, sleeps once they've finished and nobody is using it, and the switch turns itself off.
# Wake (on by default): a sleeping Mac wakes a minute after each set time, so the window still starts,
# then goes back to sleep unless someone has used it since.
# Scheduling a wake needs root; `wake allow` adds a sudoers rule for exactly that, once.

sleep_on() { [ "$(jq -r '.night // {} | if has("sleep") then .sleep else (.on // false) end' "$CONFIG" 2>/dev/null)" = true ]; }
wake_on() { [ "$(jq -r '.night.wake | if . == null then true else . end' "$CONFIG" 2>/dev/null)" = true ]; }
# An agent counts as working while it writes its session log.
# ponytail: a tool call silent for 10+ min (a long build) looks finished; watch processes if that bites.
agents_busy() { [ -n "$(find "$HOME/.claude/projects" "$SESSIONS" -name '*.jsonl' -mmin -10 2>/dev/null | head -1)" ]; }
idle_secs() { int "$(ioreg -c IOHIDSystem 2>/dev/null | awk '/HIDIdleTime/ {print int($NF / 1000000000); exit}')"; }

# The moments a message is due in the next 24 hours (for one tool, if named): set times on their days, and the end of the
# open window for tools in Back to back mode. One epoch second per line.
due_times() {
  local t time d ts days ws we
  for t in ${1:-claude codex}; do
    command -v "$t" >/dev/null || continue
    case $(cfg "$t" mode) in
      schedule)
        days=$(cfg "$t" days)
        for time in $(cfg "$t" times); do
          for d in 0 1; do
            ts=$(( $(int "$(at "$time" 2>/dev/null)") + d * 86400 ))
            [ -z "$days" ] || [[ " $days " == *" $(( ($(date +%w) + d) % 7 )) "* ]] || continue
            [ "$ts" -gt "$(now)" ] && [ "$ts" -le $(( $(now) + 86400 )) ] && echo "$ts"
          done
        done
        # A set time waiting for an open window to end.
        ws="" we=""; { read -r ws we <"$STATE/$t.waits"; } 2>/dev/null
        ws=$(int "${ws:-}") we=$(int "${we:-}")
        [ "$(int "$(cat "$STATE/$t.last" 2>/dev/null)")" -lt "$ws" ] && [ "$we" -lt $(( ws + 18000 )) ] && [ "$we" -gt "$(now)" ] &&
          [ "$we" -le $(( $(now) + 86400 )) ] && echo "$we" ;;
      watch) ts=$(reset_at "$t"); [ "$ts" -gt "$(now)" ] && [ "$ts" -le $(( $(now) + 86400 )) ] && echo "$ts" ;;
    esac
  done | sort -n | uniq
}

# When this tool sends next (epoch, 0 = nothing planned), given its reset: the next set time, or the
# end of the open window it waits for. Both the panel and the menu bar show this, so they agree.
next_at() {
  local n=0
  case $(cfg "$1" mode) in
    watch) n=$(now) ;;
    schedule) n=$(int "$(due_times "$1" | head -1)") ;;
  esac
  [ "$n" -gt 0 ] && [ "$2" -gt "$n" ] && n=$2
  echo "$n"
}

sleep_check() {
  [ "$(uname)" = Darwin ] && sleep_on || return 0
  if agents_busy; then
    # Hold off idle sleep until the next check (the plist lets this outlive the tick).
    caffeinate -i -t 330 >/dev/null 2>&1 &
    return 0
  fi
  local ts
  for ts in $(due_times); do [ "$ts" -le $(( $(now) + 900 )) ] && return 0; done   # stay up for one that's close
  [ "$(idle_secs)" -ge 600 ] || return 0
  log "sleep: agents are done and nobody is using the Mac; going to sleep (Sleep switches off)"
  set_night '{sleep: false}'
  sleep_now
}

waketime() { int "$(sysctl -n kern.waketime 2>/dev/null | sed -E 's/[^0-9]*([0-9]+).*/\1/')"; }
# our_wake: the Mac's last wake is one we scheduled and haven't put back to sleep yet; prints its time.
our_wake() {
  local w; w=$(waketime)
  awk -v w="$w" '$1 - w < 90 && w - $1 < 90 {f = 1} END {exit !f}' "$STATE/wakes" 2>/dev/null &&
    [ "$(cat "$STATE/slept" 2>/dev/null)" != "$w" ] && echo "$w"
}
sleep_now() {
  waketime >"$STATE/slept"
  [ -n "${HOLD:-}" ] && kill "$HOLD" 2>/dev/null
  pmset sleepnow >/dev/null 2>&1
}

# After a wake we scheduled: once the messages are out and the meters re-read, sleep again unless someone
# has used the Mac since. With the lid open on power and the display set to never sleep, macOS kept
# it up from 06:01 until someone came by at 08:33 (2026-10-12).
back_to_sleep() {
  [ "$(uname)" = Darwin ] && wake_on || return 0
  local w t ts
  w=$(our_wake) || return 0
  [ $(( $(idle_secs) + 120 )) -ge $(( $(now) - w )) ] || return 0   # someone has used it since
  agents_busy && return 0
  for ts in $(due_times); do [ "$ts" -le $(( $(now) + 900 )) ] && return 0; done
  for t in claude codex; do
    command -v "$t" >/dev/null && [ -n "$(cfg "$t" mode | grep -v '^off$')" ] || continue
    # Stay up (for an hour at most) while a failed message waits for its retry, and until the meters
    # are re-read, so the panel and menu bar show the new window.
    [ $(( $(now) - w )) -lt 3600 ] || continue
    [ "$(now)" -lt "$(int "$(cat "$STATE/$t.backoff" 2>/dev/null)")" ] && return 0
    case $t in
      claude) claude_usage
              [ -s "$STATE/claude.limits" ] && [ "$(int "$(jq '.at' "$STATE/claude.limits")")" -ge "$(int "$(cat "$STATE/claude.last" 2>/dev/null)")" ] || return 0 ;;
      codex) codex_live >/dev/null || return 0 ;;
    esac
  done
  log "wake: messages sent and usage read; nobody is using the Mac, so back to sleep"
  sleep_now
}

wake_allowed() { sudo -n -l /usr/bin/pmset schedule wake "01/01/30 00:00:00" >/dev/null 2>&1; }
pm_date() { date -r "$1" '+%m/%d/%y %H:%M:%S'; }
# Keep exactly one wake, a minute after each due moment, in pmset's schedule; drop ours that went stale.
wake_sync() {
  [ "$(uname)" = Darwin ] && wake_allowed || return 0
  local want="" ts have
  wake_on && want=$(for ts in $(due_times); do echo $(( ts + 60 )); done)
  have=$(awk -v n="$(now)" '$1 > n' "$STATE/wakes" 2>/dev/null)
  for ts in $have; do
    grep -qx "$ts" <<<"$want" || sudo -n /usr/bin/pmset schedule cancel wake "$(pm_date "$ts")" >/dev/null 2>&1
  done
  for ts in $want; do
    grep -qx "$ts" <<<"$have" || sudo -n /usr/bin/pmset schedule wake "$(pm_date "$ts")" >/dev/null 2>&1 || log "wake: couldn't schedule $(fmt "$ts")"
  done
  # Keep the last day's past wakes too: back_to_sleep matches the Mac's wake time against them.
  { awk -v n="$(now)" '$1 <= n && $1 > n - 86400' "$STATE/wakes" 2>/dev/null; printf '%s\n' $want; } >"$STATE/wakes.tmp" &&
    mv -f "$STATE/wakes.tmp" "$STATE/wakes"
}

# The password dialog is macOS's own; nothing here sees it.
admin() { osascript -e "do shell script \"$1\" with administrator privileges" >/dev/null; }

set_night() {
  { [ -s "$CONFIG" ] && cat "$CONFIG" || echo '{}'; } | jq ".night = ((.night // {}) + $1)" >"$CONFIG.tmp" && mv -f "$CONFIG.tmp" "$CONFIG"
}

sleep_cmd() {
  case ${1:-} in
    on) set_night '{sleep: true}'; echo "the Mac sleeps once Claude Code and Codex have finished, then this switches off" ;;
    off) set_night '{sleep: false}'; echo "sleep off" ;;
    *) echo "usage: usageforge sleep on | off" >&2; exit 1 ;;
  esac
}

wake_cmd() {
  local user rule
  case ${1:-} in
    on) set_night '{wake: true}'; wake_allowed || echo "run 'usageforge wake allow' once so macOS lets UsageForge schedule wakes"; wake_sync; echo "wake on" ;;
    off) set_night '{wake: false}'; wake_sync; echo "wake off: a sleeping Mac stays asleep at your set times" ;;
    allow)
      [ "$(uname)" = Darwin ] || { echo "wake is macOS only" >&2; exit 1; }
      user=$(id -un); [[ $user =~ ^[A-Za-z0-9._-]+$ ]] || { echo "unexpected user name: $user" >&2; exit 1; }
      rule="$STATE/sudoers"
      printf '# UsageForge: schedule and cancel wakes for set times (usageforge wake allow)\n%s ALL=(root) NOPASSWD: /usr/bin/pmset schedule wake *, /usr/bin/pmset schedule cancel wake *\n' "$user" >"$rule"
      admin "/usr/sbin/visudo -cf '$rule' && /usr/bin/install -m 440 -o root -g wheel '$rule' /etc/sudoers.d/usageforge" ||
        { rm -f "$rule"; echo "not changed (no password given)" >&2; exit 1; }
      rm -f "$rule"; set_night '{wake: true}'; wake_sync; echo "allowed: the Mac wakes for your set times" ;;
    sync) wake_sync ;;
    *) echo "usage: usageforge wake on | off | allow" >&2; exit 1 ;;
  esac
}

# ---------- Installing the check ----------

# start: run `tick` every 5 minutes (launchd on macOS, cron elsewhere). Settings are re-read each time.
start() {
  local bin="$STATE/usageforge" env extra=""
  # Run a copy: launchd can't read ~/Desktop or ~/Documents (macOS privacy), and the repo may move.
  # Copy then rename, so a run that is mid-sleep keeps reading its own (old) file.
  if [ "$SELF" != "$bin" ]; then
    cp "$SELF" "$bin.tmp" && chmod 700 "$bin.tmp" && mv -f "$bin.tmp" "$bin" || { echo "start failed: copy to $bin" >&2; exit 1; }
  fi
  if [ "$(uname)" = Darwin ]; then
    # launchd (not cron): runs in your login session so `claude` can read its Keychain token,
    # and runs missed checks when the Mac wakes up.
    mkdir -p "$(dirname "$PLIST")"
    [ -n "${CODEX_HOME:-}" ] && extra="<key>CODEX_HOME</key><string>$(xml "$CODEX_HOME")</string>"
    cat >"$PLIST.tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$(xml "$bin")</string><string>tick</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>$(xml "$PATH")</string>
    <key>UF_STATE</key><string>$(xml "$STATE")</string>
    $extra
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <!-- Also on every wake and sleep: launchd's 5-minute timer often misses the few seconds a lid-closed Mac stays up. -->
  <key>LaunchEvents</key><dict><key>com.apple.notifyd.matching</key><dict>
    <key>power</key><dict><key>Notification</key><string>com.apple.powermanagement.systempowerstate</string></dict>
  </dict></dict>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>$(xml "$STATE/log")</string>
</dict></plist>
EOF
    plutil -lint -s "$PLIST.tmp" || { echo "start failed: bad plist" >&2; rm -f "$PLIST.tmp"; exit 1; }
    stop >/dev/null; mv -f "$PLIST.tmp" "$PLIST"
    # bootstrap right after bootout sometimes fails with "I/O error"; one retry fixes it.
    launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || { sleep 2; launchctl bootstrap "gui/$(id -u)" "$PLIST"; } ||
      { echo "start failed: launchctl bootstrap" >&2; exit 1; }
  else
    stop >/dev/null
    env="PATH=$(printf %q "$PATH") UF_STATE=$(printf %q "$STATE")"
    [ -n "${CODEX_HOME:-}" ] && env+=" CODEX_HOME=$(printf %q "$CODEX_HOME")"
    # cron treats % as a newline, so escape it everywhere on the line.
    local line="*/5 * * * * $env $(printf %q "$bin") tick"
    { crontab -l 2>/dev/null; echo "${line//%/\\%} # $LABEL"; } | crontab - || { echo "start failed: crontab" >&2; exit 1; }
  fi
  echo "started: checking every 5 minutes. Log: $STATE/log"
}

stop() {
  if [ "$(uname)" = Darwin ]; then
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null; rm -f "$PLIST"
  else
    crontab -l 2>/dev/null | grep -v "# $LABEL\$" | crontab -
  fi
  echo "stopped (settings kept in $STATE)"
}

running() {
  [ -x "$STATE/usageforge" ] || return 1
  if [ "$(uname)" = Darwin ]; then launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1
  else crontab -l 2>/dev/null | grep -q "# $LABEL\$"; fi
}

schedule() {
  local t
  [ $# -gt 0 ] || { echo "usage: usageforge schedule HH:MM [HH:MM...]"; exit 1; }
  for t in "$@"; do [[ $t =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]] || { echo "bad time: $t (want HH:MM)"; exit 1; }; done
  [ -n "${TOOLS// /}" ] || { echo "neither claude nor codex found on PATH" >&2; exit 1; }
  set_mode schedule "$@" && start
}

watch() {
  [ -n "${TOOLS// /}" ] || { echo "neither claude nor codex found on PATH" >&2; exit 1; }
  set_mode watch && start
}

# ---------- Status ----------

status() {
  local t r m
  for t in claude codex; do
    m=$(cfg "$t" mode)
    command -v "$t" >/dev/null || { [ "${m:-off}" = off ] || echo "$t: $(mode_name "$m"), but not installed"; continue; }
    [ "$t" = claude ] && claude_usage
    r=$(reset_at "$t")
    printf '%s: %s, ' "$t" "$(mode_name "$m")"
    [ "$r" -gt "$(now)" ] && echo "window resets $(fmt "$r")" || echo "no window running"
  done
  running && echo "check: on (every 5 min)" || echo "check: off"
  [ -f "$STATE/log" ] && { echo "recent log:"; tail -n 5 "$STATE/log" | sed 's/^/  /'; }
  return 0
}

# Everything the control panel shows, as one JSON object.
status_json() {
  local t tools='{}' entry limits r
  for t in claude codex; do
    if [ "$t" = claude ]; then
      command -v claude >/dev/null && claude_usage
      limits=$(jq -c '{five_hour: ((.unifiedWindows.five_hour.utilization // null) | if . then . * 100 else null end),
                       weekly: ((.unifiedWindows.seven_day.utilization // null) | if . then . * 100 else null end),
                       weekly_reset: (.unifiedWindows.seven_day.resetsAt // null), updated: (.at // null)}' "$STATE/claude.limits" 2>/dev/null)
    else
      limits=$(codex_limits | jq -c '{five_hour: (.primary.used_percent // null), weekly: (.secondary.used_percent // null),
                                      weekly_reset: (.secondary.resets_at // null)}' 2>/dev/null)
    fi
    r=$(reset_at "$t")
    entry=$(jq -n --argjson installed "$(command -v "$t" >/dev/null && echo true || echo false)" \
      --argjson reset "$r" --argjson next "$(command -v "$t" >/dev/null && next_at "$t" "$r" || echo 0)" \
      --argjson backoff "$(int "$(cat "$STATE/$t.backoff" 2>/dev/null)")" \
      --argjson limits "${limits:-"{}"}" '{installed: $installed, reset: $reset, next: $next, backoff: $backoff} + $limits')
    tools=$(jq -c --arg t "$t" --argjson e "$entry" '.[$t] = $e' <<<"$tools")
  done
  jq -n --argjson tools "$tools" --argjson config "$( [ -s "$CONFIG" ] && cat "$CONFIG" || echo '{}')" \
    --argjson running "$(running && echo true || echo false)" --argjson now "$(now)" \
    --arg log "$(tail -n 40 "$STATE/log" 2>/dev/null)" \
    --argjson allowed "$(wake_allowed && echo true || echo false)" --argjson next "$(int "$(due_times | head -1)")" \
    '{now: $now, wake: {allowed: $allowed, next: $next}, running: $running, config: $config, tools: $tools,
      log: ($log | split("\n") | map(select(length > 0)))}'
}

# ---------- Doctor ----------

doctor() {
  local bad=0 t m n bin jobpath
  ok() { echo "  ✓ $*"; }
  warn() { echo "  ! $*"; }
  fail() { echo "  ✗ $*"; bad=1; }
  echo "UsageForge $VERSION"
  ok "$(jq --version) installed"
  command -v python3 >/dev/null && ok "python3 found (for 'usageforge ui')" || warn "python3 not found: 'usageforge ui' won't start"
  [ -f "$PLIST" ] && jobpath=$(plutil -extract EnvironmentVariables.PATH raw "$PLIST" 2>/dev/null)
  for t in claude codex; do
    m=$(cfg "$t" mode); m=${m:-off}; n=$(name_of "$t")
    echo "$n ($(mode_name "$m"))"
    if ! command -v "$t" >/dev/null; then
      [ "$m" = off ] && warn "not installed" || fail "set to '$(mode_name "$m")' but '$t' isn't installed"
      continue
    fi
    bin=$(command -v "$t")
    if [ "$t" = claude ]; then
      [ "$(claude auth status --json 2>/dev/null | jq -r '.loggedIn // false')" = true ] && ok "signed in" || fail "not signed in: run 'claude' and log in"
    else
      codex login status 2>&1 | grep -q '^Logged in' && ok "signed in" || fail "not signed in: run 'codex login'"
    fi
    [ -n "$jobpath" ] && [ "$m" != off ] && { PATH="$jobpath" command -v "$t" >/dev/null && ok "the background job can find it" ||
      fail "the background job can't find $bin: run 'usageforge start' again from this terminal"; }
    [ "$m" = schedule ] && [ -z "$(cfg "$t" times)" ] && fail "'At set times' is on but no times are set"
    [ "$m" != off ] && [ "$(int "$(cat "$STATE/$t.backoff" 2>/dev/null)")" -gt "$(now)" ] && warn "last message failed; retrying at $(fmt "$(cat "$STATE/$t.backoff")")"
  done
  echo "Background check"
  if running; then
    ok "on, every 5 minutes"
    cmp -s "$SELF" "$STATE/usageforge" || warn "it runs an older copy: run 'usageforge start' to update it"
  else
    [ -n "$(jq -r '[.claude.mode, .codex.mode] | map(select(. != null and . != "off")) | .[]' "$CONFIG" 2>/dev/null)" ] &&
      fail "off, but a tool has a mode set: run 'usageforge start'" || warn "off: nothing is scheduled. Run 'usageforge ui' to pick times"
  fi
  n=$(grep -c "$(date +%F).*failed" "$STATE/log" 2>/dev/null); n=$(int "$n")
  [ "$n" -gt 0 ] && warn "$n failed message(s) today; see 'usageforge status'"
  if [ "$(uname)" = Darwin ]; then
    echo "Sleep and wake"
    sleep_on && ok "sleep: on, the Mac sleeps once agents have finished" || ok "sleep: off"
    if ! wake_on; then warn "wake: off, so a sleeping Mac misses its set times"
    elif wake_allowed; then ok "wake: on, a sleeping Mac wakes for each set time"
    else warn "wake is on, but macOS hasn't allowed it yet: run 'usageforge wake allow'"; fi
  fi
  [ $bad = 0 ] && echo "All good." || echo "Fix the ✗ items above."
  return $bad
}

# One job run at a time: cron (unlike launchd) will start a new run while a slow one still sleeps.
lock() {
  find "$STATE/lock" -maxdepth 0 -mmin +30 -exec rmdir {} \; 2>/dev/null   # stale after a crash
  mkdir "$STATE/lock" 2>/dev/null || exit 0
  trap 'rmdir "$STATE/lock" 2>/dev/null' EXIT
}

case "${1:-}" in
  ping) shift; ping "$@" ;;
  tick) lock; tick ;;
  schedule) shift; schedule "$@" ;;
  watch) watch ;;
  start) start ;;
  stop) stop ;;
  status) case ${2:-} in --json) status_json ;; "") status ;; *) echo "usage: usageforge status [--json]" >&2; exit 1 ;; esac ;;
  doctor) doctor ;;
  sleep) shift; sleep_cmd "$@" ;;
  wake) shift; wake_cmd "$@" ;;
  notify-test) UF_FORCE=1 notify problems "UsageForge" "Notifications work. You'll hear from us when something needs you." ;;
  ui) command -v python3 >/dev/null || { echo "usageforge ui needs python3" >&2; exit 1; }
      [ -f "$(dirname "$SELF")/ui/server.py" ] || { echo "run 'usageforge ui' from the UsageForge repo" >&2; exit 1; }
      shift; exec python3 -B "$(dirname "$SELF")/ui/server.py" "$SELF" "$@" ;;
  -v|--version|version) echo "usageforge $VERSION" ;;
  ""|-h|--help|help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "unknown command: $1 (see 'usageforge help')" >&2; exit 1 ;;
esac
