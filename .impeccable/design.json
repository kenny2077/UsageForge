      "css": ".ds-meter{font-family:Jost,-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;display:grid;grid-template-columns:1fr auto;align-items:baseline;gap:6px 12px;padding:12px;background:#06080d;}.ds-meter .n{color:#b8c1d2;font-size:14px;}.ds-meter .v{color:#8b95aa;font-size:13px;}.ds-meter .v b{color:#e8ecf4;font-weight:500;}.ds-dots{grid-column:1/-1;display:grid;grid-template-columns:repeat(20,1fr);gap:4px;}.ds-dots i{aspect-ratio:1;width:100%;max-width:11px;justify-self:center;border-radius:50%;background:rgba(168,186,224,.12);transition:background .25s;}.ds-dots i.on{background:#f3b46a;}.ds-dots i.on:nth-child(n+8){background:#f6c27c;}.ds-dots i.on:nth-child(n+14){background:#ffe2b0;}"
